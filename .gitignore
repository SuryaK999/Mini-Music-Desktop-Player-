# ==============================================================================
# ❤ MINI PLAYER - Git Ignore Configurations
# ==============================================================================
# This file specifies intentionally untracked files that Git should ignore.
# Highly tailored for Electron.js, Node.js development, and OS-specific clutter.

# ------------------------------------------------------------------------------
# 1. Dependency Directories (Crucial!)
# ------------------------------------------------------------------------------
# Never upload node_modules to GitHub; it contains massive quantities of external
# package dependencies that should be installed locally using 'npm install'.
node_modules/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 2. Operating System Clutter
# ------------------------------------------------------------------------------
# OS-specific metadata files that add clutter and trigger redundant changes.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 3. Log & Debugging Files
# ------------------------------------------------------------------------------
# Diagnostic logs generated during application execution or runtime failures.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Sensitive Environment Variables & Credentials
# ------------------------------------------------------------------------------
# Security measure: Prevent accidental leak of API keys, tokens, or local setups.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------------------------------------------
# 5. IDE, Editors, and Workspace Configurations
# ------------------------------------------------------------------------------
# Ignore developer-specific settings or visual styles. Let everyone use their own.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.settings/
.buildpath

# ------------------------------------------------------------------------------
# 6. Electron Builds, Packages, and Compilations
# ------------------------------------------------------------------------------
# Production packaging outputs generated by builders (e.g., electron-builder).
dist/
out/
release/
build/
bin/
obj/

# Package formats for installers
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.tar.gz

# ------------------------------------------------------------------------------
# 7. Local Test Media & Songs (Highly Recommended)
# ------------------------------------------------------------------------------
# Music players require audio files for testing, but committing large high-fidelity
# files can easily exceed GitHub's size limit (100MB) and bloat repo size.
# Create a local 'songs/' or 'music/' folder for test tracks and keep it offline.
songs/
music/
audio/
*.mp3
*.wav
*.flac
*.m4a
