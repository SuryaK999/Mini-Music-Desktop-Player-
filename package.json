{
  "name": "music-player",
  "version": "1.0.0",
  "description": "Mini Music Desktop Player",
  "main": "main.js",
  "scripts": {
    "test": "node --check main.js && node --check preload.js && node --check renderer.js && node -e \"console.log('Syntax check passed.')\"",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder build --win",
    "build:mac": "electron-builder build --mac",
    "build:linux": "electron-builder build --linux",
    "build:all": "electron-builder -mwl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryaK999/Mini-Music-Desktop-Player-.git"
  },
  "keywords": [
    "electron",
    "music-player",
    "desktop-app",
    "audio"
  ],
  "author": "SuryaK999 <suryak999@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "music-metadata": "^11.12.3"
  },
  "build": {
    "appId": "com.suryak999.minimusicplayer",
    "productName": "Serene-Music-Player",
    "icon": "assets/music.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist${/*}",
      "!.git${/*}",
      "!.github${/*}"
    ],
    "win": {
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serene Music Player",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Audio",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "SuryaK999",
      "repo": "Mini-Music-Desktop-Player-"
    }
  }
}
