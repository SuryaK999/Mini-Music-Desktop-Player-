{
  "name": "music-player",
  "version": "1.0.0",
  "description": "Mini Music Desktop Player",
  "main": "main.js",
  "scripts": {
    "test": "node -e \"console.log('Build test passed.')\"",
    "start": "electron .",
    "build": "electron-builder build --win",
    "build:win": "electron-builder build --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryaK999/Mini-Music-Desktop-Player-.git"
  },
  "keywords": [
    "electron",
    "music-player",
    "desktop-app",
    "audio"
  ],
  "author": "SuryaK999 <suryak999@users.noreply.github.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "music-metadata": "^11.12.3"
  },
  "build": {
    "appId": "com.suryak999.minimusicplayer",
    "productName": "Serene-Music-Player",
    "icon": "assets/music.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist${/*}",
      "!.git${/*}",
      "!.github${/*}"
    ],
    "win": {
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serene Music Player"
    },
    "publish": {
      "provider": "github",
      "owner": "SuryaK999",
      "repo": "Mini-Music-Desktop-Player-"
    }
  }
}
